<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EngelsizDPI.App">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Renkler temaya göre: koyu = gece mavisi, açık = kırık beyaz; vurgu ikisinde de kiremit.
           Durum renkleri (bilerek yeşil yok): bağlı = kiremit, bağlanıyor = mavi, hata = pembe-kırmızı. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgBrush" Color="#0F1624" />
          <SolidColorBrush x:Key="CardBrush" Color="#172032" />
          <SolidColorBrush x:Key="LineBrush" Color="#26324A" />
          <SolidColorBrush x:Key="SeparatorBrush" Color="#1E2940" />
          <SolidColorBrush x:Key="TextBrush" Color="#E8ECF3" />
          <SolidColorBrush x:Key="MutedBrush" Color="#93A0B8" />
          <SolidColorBrush x:Key="DimBrush" Color="#5E6A82" />
          <SolidColorBrush x:Key="AvatarBrush" Color="#1E2940" />
          <SolidColorBrush x:Key="AccentBrush" Color="#E86F3A" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#F08250" />
          <SolidColorBrush x:Key="OnAccentBrush" Color="#2A0E04" />
          <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#2A2231" />

          <SolidColorBrush x:Key="OnCardBrush" Color="#1F2033" />
          <SolidColorBrush x:Key="OnCardBorderBrush" Color="#673320" />
          <SolidColorBrush x:Key="BusyBrush" Color="#9CC3F0" />
          <SolidColorBrush x:Key="BusyTrackBrush" Color="#2E4668" />
          <SolidColorBrush x:Key="BusyCardBorderBrush" Color="#2E4668" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#EF6B85" />
          <SolidColorBrush x:Key="ErrorCardBrush" Color="#231C2A" />
          <SolidColorBrush x:Key="ErrorCardBorderBrush" Color="#5C2A3A" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#F3B2BF" />

          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#E86F3A" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#F08250" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#D5612F" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#2A0E04" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#2A0E04" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#2A0E04" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#93A0B8" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#B5C0D4" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#93A0B8" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#B5C0D4" />
          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#1E2940" />

          <SolidColorBrush x:Key="TextControlBackground" Color="#0F1624" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#121B2C" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0F1624" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#26324A" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#34435F" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E86F3A" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5E6A82" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#5E6A82" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5E6A82" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#172032" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1E2940" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#26324A" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#34435F" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#172032" />
          <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#131B2B" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#1E2940" />
          <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#5E6A82" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#E86F3A" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#F08250" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#2A0E04" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#2A0E04" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgBrush" Color="#F7F4EF" />
          <SolidColorBrush x:Key="CardBrush" Color="#FFFDFA" />
          <SolidColorBrush x:Key="LineBrush" Color="#E7E0D6" />
          <SolidColorBrush x:Key="SeparatorBrush" Color="#F0EBE3" />
          <SolidColorBrush x:Key="TextBrush" Color="#231F1A" />
          <SolidColorBrush x:Key="MutedBrush" Color="#6E665C" />
          <SolidColorBrush x:Key="DimBrush" Color="#A39A8E" />
          <SolidColorBrush x:Key="AvatarBrush" Color="#F1ECE4" />
          <SolidColorBrush x:Key="AccentBrush" Color="#C24E1C" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#D05A26" />
          <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FCEFE6" />

          <SolidColorBrush x:Key="OnCardBrush" Color="#FCEFE6" />
          <SolidColorBrush x:Key="OnCardBorderBrush" Color="#EBC0A6" />
          <SolidColorBrush x:Key="BusyBrush" Color="#2F6FB5" />
          <SolidColorBrush x:Key="BusyTrackBrush" Color="#D6E4F4" />
          <SolidColorBrush x:Key="BusyCardBorderBrush" Color="#B8D0EA" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#BF3651" />
          <SolidColorBrush x:Key="ErrorCardBrush" Color="#FBECEF" />
          <SolidColorBrush x:Key="ErrorCardBorderBrush" Color="#EDB7C3" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#9A2A40" />

          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#C24E1C" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D05A26" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#AD4417" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#6E665C" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#4F4840" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#6E665C" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#4F4840" />
          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#F1ECE4" />

          <SolidColorBrush x:Key="TextControlBackground" Color="#FBF8F3" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFDFA" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#E7E0D6" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#D8CFC2" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C24E1C" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A39A8E" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#A39A8E" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#A39A8E" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFDFA" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F7F4EF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#E7E0D6" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#D8CFC2" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFDFA" />
          <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F1ECE4" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#E7E0D6" />
          <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#A39A8E" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#C24E1C" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#D05A26" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Material Design Icons (Apache-2.0) -->
      <StreamGeometry x:Key="ShieldIcon">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z</StreamGeometry>
      <StreamGeometry x:Key="ShieldOutlineIcon">M21,11C21,16.55 17.16,21.74 12,23C6.84,21.74 3,16.55 3,11V5L12,1L21,5V11M12,21C15.75,20 19,15.54 19,11.22V6.3L12,3.18L5,6.3V11.22C5,15.54 8.25,20 12,21Z</StreamGeometry>
      <StreamGeometry x:Key="ShieldAlertIcon">M21,11C21,16.55 17.16,21.74 12,23C6.84,21.74 3,16.55 3,11V5L12,1L21,5V11M12,21C15.75,20 19,15.54 19,11.22V6.3L12,3.18L5,6.3V11.22C5,15.54 8.25,20 12,21M11,7H13V13H11V7M11,15H13V17H11V15Z</StreamGeometry>
      <StreamGeometry x:Key="ShieldSyncIcon">M12 21C8.25 20 5 15.54 5 11.22V6.3L12 3.18L19 6.3V12.07A6.45 6.45 0 0 1 20.91 12.67A11.63 11.63 0 0 0 21 11V5L12 1L3 5V11C3 16.55 6.84 21.74 12 23C12.35 22.91 12.7 22.8 13 22.68A6.3 6.3 0 0 1 12 21M18 14.5V13L15.75 15.25L18 17.5V16A2.5 2.5 0 0 1 20.24 19.62L21.33 20.71A4 4 0 0 0 18 14.5M18 21A2.5 2.5 0 0 1 15.76 17.38L14.67 16.29A4 4 0 0 0 18 22.5V24L20.25 21.75L18 19.5Z</StreamGeometry>
      <StreamGeometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
      <StreamGeometry x:Key="PlusIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
      <StreamGeometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
      <StreamGeometry x:Key="CheckIcon">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#E86F3A" RegionColor="#0F1624" AltHigh="#0F1624" />
        <ColorPaletteResources x:Key="Light" Accent="#C24E1C" RegionColor="#F7F4EF" AltHigh="#F7F4EF" />
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Styles>
</Application>
