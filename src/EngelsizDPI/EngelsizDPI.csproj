<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>EngelsizDPI</AssemblyName>
    <RootNamespace>EngelsizDPI</RootNamespace>
    <Version>1.0.0</Version>
    <Product>EngelsizDPI</Product>
    <Description>Discord ve Roblox'a VPN'siz erişim · GoodbyeDPI + Güvenli DNS</Description>
    <!-- Güncellemelerin kontrol edileceği GitHub deposu. CI'da otomatik olarak doldurulur. -->
    <GitHubRepo Condition="'$(GitHubRepo)' == ''">Claymore222/EngelsizDPI</GitHubRepo>
  </PropertyGroup>

  <!-- Tek dosya, kurulumsuz (portable) yayın: dotnet publish -c Release -r win-x64
       Yalnızca hedef platform (-r) verildiğinde uygulanır; aksi halde test projesi uygulamaya başvuramaz. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GitHubRepo" Value="$(GitHubRepo)" />
    <InternalsVisibleTo Include="EngelsizDPI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Motor dosyaları exe'ye gömülür ve ilk çalıştırmada ProgramData altına çıkarılır. -->
    <EmbeddedResource Include="Engine\win-x64\*" LogicalName="engine.win-x64.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
