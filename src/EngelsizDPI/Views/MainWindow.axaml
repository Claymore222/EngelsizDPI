<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EngelsizDPI.ViewModels"
        xmlns:v="using:EngelsizDPI.Views"
        xmlns:core="using:EngelsizDPI.Core"
        x:Class="EngelsizDPI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="EngelsizDPI"
        Icon="/Assets/app.ico"
        Width="460" Height="820" MinWidth="400" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">

  <Window.Styles>
    <!-- Ayarlar uygulaması tarzı kart ve satırlar -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.row.last">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="4,20,0,8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Metin gibi görünen bağlantı düğmesi -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.link:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    </Style>
    <Style Selector="Button.link.quiet">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Button.link.quiet:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.plain">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Büyük bağlantı anahtarı -->
    <Style Selector="Button.switch">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}" />
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="PathIcon.spin">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,18,20,20">

      <!-- Başlık -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="32" Height="32" CornerRadius="7" Background="{StaticResource AccentBrush}">
          <PathIcon Width="18" Height="18" Foreground="{StaticResource OnAccentBrush}" Data="{StaticResource ShieldIcon}" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="EngelsizDPI" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="GoodbyeDPI + güvenli DNS" />
        </StackPanel>
      </StackPanel>

      <!-- Bilgi bantları -->
      <Border Classes="card" Margin="0,16,0,0" Padding="14,10" IsVisible="{Binding HasNotice}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Width="16" Height="16" Foreground="{StaticResource AccentBrush}" Data="{StaticResource CheckIcon}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="link quiet" Margin="8,0,0,0" Content="Tamam" Command="{Binding DismissNoticeCommand}" />
        </Grid>
      </Border>

      <Border Classes="card" Margin="0,16,0,0" Padding="14,10" IsVisible="{Binding Update.IsAvailable}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Update.BannerText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="accent" Margin="10,0,0,0" Content="{Binding Update.ActionLabel}"
                    Command="{Binding Update.UpdateNowCommand}" IsEnabled="{Binding !Update.IsDownloading}" />
          </Grid>
          <ProgressBar IsVisible="{Binding Update.IsDownloading}" Value="{Binding Update.Progress}" Maximum="100"
                       Height="3" MinHeight="3" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
      </Border>

      <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1"
              Background="#231C2A" BorderBrush="#5C2A3A" IsVisible="{Binding HasConflict}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap" FontSize="12" Foreground="#F3B2BF" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="plain" Margin="10,0,0,0" Content="Düzelt" Command="{Binding FixConflictsCommand}" />
        </Grid>
      </Border>

      <!-- Durum kartı -->
      <Border Margin="0,16,0,0" Padding="18,18" CornerRadius="8" BorderThickness="1"
              Background="{Binding State, Converter={x:Static v:Converters.StateCardBackground}}"
              BorderBrush="{Binding State, Converter={x:Static v:Converters.StateCardBorder}}">
        <Border.Transitions>
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.25" />
            <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
          </Transitions>
        </Border.Transitions>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Center"
                    Classes.spin="{Binding IsBusy}"
                    Data="{Binding State, Converter={x:Static v:Converters.StateIcon}}"
                    Foreground="{Binding State, Converter={x:Static v:Converters.StateBrush}}">
            <PathIcon.RenderTransform><RotateTransform /></PathIcon.RenderTransform>
          </PathIcon>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{Binding State, Converter={x:Static v:Converters.StateBrush}}" />
            <TextBlock Classes="muted" Text="{Binding StatusDetail}" TextWrapping="Wrap" FontSize="13" />
          </StackPanel>
          <Button Grid.Column="2" Classes="switch" Margin="12,0,0,0" VerticalAlignment="Center"
                  Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding ToggleLabel}">
            <Border Width="52" Height="28" CornerRadius="14" BorderThickness="1" Padding="4"
                    Background="{Binding State, Converter={x:Static v:Converters.SwitchFill}}"
                    BorderBrush="{Binding State, Converter={x:Static v:Converters.SwitchStroke}}">
              <Ellipse Width="18" Height="18"
                       HorizontalAlignment="{Binding SwitchOn, Converter={x:Static v:Converters.KnobAlignment}}"
                       Fill="{Binding State, Converter={x:Static v:Converters.SwitchKnob}}" />
            </Border>
          </Button>
        </Grid>
      </Border>

      <!-- Siteler -->
      <TextBlock Classes="section" Text="Siteler" />
      <Border Classes="card">
        <StackPanel>
          <Border Padding="12,10" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <TextBox Text="{Binding SearchText}" PlaceholderText="Site ara" CornerRadius="6" MinHeight="32">
              <TextBox.InnerLeftContent>
                <PathIcon Width="14" Height="14" Margin="10,0,0,0" Foreground="{StaticResource DimBrush}" Data="{StaticResource SearchIcon}" />
              </TextBox.InnerLeftContent>
            </TextBox>
          </Border>

          <ItemsControl ItemsSource="{Binding VisiblePacks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PackItem">
                <Border Classes="row">
                  <Grid ColumnDefinitions="Auto,*,Auto,44">
                    <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource AvatarBrush}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="13"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,9" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontSize="14"
                                 Foreground="{Binding Enabled, Converter={x:Static v:Converters.EnabledNameBrush}}" />
                      <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12"
                               Text="{Binding Status, Converter={x:Static v:Converters.PackStatusText}}"
                               Foreground="{Binding Status, Converter={x:Static v:Converters.PackStatusBrush}}" />
                    <ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled}" IsVisible="{Binding !IsCustom}" HorizontalAlignment="Right" />
                    <Button Grid.Column="3" Classes="link quiet" IsVisible="{Binding IsCustom}" ToolTip.Tip="Kaldır" HorizontalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveCustomCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Width="12" Height="12" Data="{StaticResource CloseIcon}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Site ekle / tara / öner -->
          <Button Classes="link" Margin="10,8" Command="{Binding ToggleAddPanelCommand}" IsVisible="{Binding !IsAddOpen}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Width="12" Height="12" Data="{StaticResource PlusIcon}" />
              <TextBlock Text="Site ekle veya tara" FontSize="13" />
            </StackPanel>
          </Button>

          <StackPanel IsVisible="{Binding IsAddOpen}" Margin="16,12,16,14" Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding NewDomain}" PlaceholderText="reddit.com" CornerRadius="6" MinHeight="32">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding AddDomainCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" Content="Ekle" Command="{Binding AddDomainCommand}" />
              <Button Grid.Column="2" Classes="link quiet" Margin="4,0,0,0" ToolTip.Tip="Kapat" Command="{Binding ToggleAddPanelCommand}">
                <PathIcon Width="12" Height="12" Data="{StaticResource CloseIcon}" />
              </Button>
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding AddMessage, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="Eklediğiniz sitenin kullandığı diğer adresler (resimler, sunucular) otomatik taranır ve engelli olanlar önerilir." />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsScanning}">
              <ProgressBar IsIndeterminate="True" Width="80" Height="3" MinHeight="3" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding AddMessage}"
                       IsVisible="{Binding AddMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ItemsControl ItemsSource="{Binding ScanResults}" IsVisible="{Binding HasScanResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScanSuggestion">
                  <CheckBox IsChecked="{Binding Selected}" Content="{Binding Domain}" FontFamily="Consolas, Menlo, monospace" FontSize="12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="plain" Content="Seçilenleri ekle" Command="{Binding AddSuggestionsCommand}" IsVisible="{Binding HasScanResults}" />
              <Button Classes="link" Content="Tekrar tara" Command="{Binding ScanCommand}"
                      IsVisible="{Binding LastAddedDomain, Converter={x:Static ObjectConverters.IsNotNull}}" IsEnabled="{Binding !IsScanning}" />
              <Button Classes="link" Content="Herkese öner" Command="{Binding SuggestToEveryoneCommand}"
                      IsVisible="{Binding LastAddedDomain, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ToolTip.Tip="Bu siteyi GitHub'da herkesin listesine eklenmesi için önerin" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Yöntem -->
      <TextBlock Classes="section" Text="Yöntem" />
      <Border Classes="card" Padding="16,12">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch"
                      CornerRadius="6" IsEnabled="{Binding !IsBusy}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:BypassProfile">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Classes="link" Margin="12,0,0,0" Content="Otomatik bul" Command="{Binding AutoFindCommand}"
                    IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Tüm yöntemleri dener ve sizin bağlantınızda çalışanı seçer" />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SelectedProfile.Description}" />
        </StackPanel>
      </Border>

      <!-- Ayarlar -->
      <TextBlock Classes="section" Text="Ayarlar" />
      <Border Classes="card">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Windows açılınca başlat" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Açılışta otomatik bağlan" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConnectOnLaunch}" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center" Margin="0,9" Spacing="2">
                <TextBlock Text="Güvenli DNS" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="DNS sorgularını Yandex DNS'e (port 1253) yönlendirir" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding DnsRedirect}" />
            </Grid>
          </Border>
          <Border Classes="row last" IsVisible="{Binding Update.CanCheck}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Otomatik güncelle" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Update.AutoUpdate}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Alt bilgi -->
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,14,0,0">
        <TextBlock Classes="muted" Text="{Binding AppVersion}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="link quiet" FontSize="12" Content="Güncellemeleri denetle"
                Command="{Binding Update.CheckCommand}" IsVisible="{Binding Update.CanCheck}" />
        <Button Grid.Column="3" Classes="link quiet" FontSize="12" Content="Günlük" Command="{Binding OpenLogCommand}"
                ToolTip.Tip="Sorun bildirirken bu dosyayı ekleyin" />
      </Grid>
      <TextBlock Classes="muted" FontSize="11" Margin="4,4,0,0" TextWrapping="Wrap" Text="{Binding Update.CheckMessage}"
                 IsVisible="{Binding Update.CheckMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </ScrollViewer>
</Window>
